# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# regenerated by `next dev`/`next build` on every run — not source, not committed
/AGENTS.md
/CLAUDE.md

# database (seeded locally via `npm run db:seed`; not committed)
/prisma/dev.db
/prisma/dev.db-journal

# testing artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# scratch snapshots/logs saved by the Playwright MCP tool during manual verification
/.playwright-mcp/
